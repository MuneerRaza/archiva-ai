# ===========================================
# Archiva.ai — Environment Variables
# Copy to .env and fill in your values
# Uses __ (double underscore) as nested delimiter for Pydantic Settings
# ===========================================

# --- App ---
APP__ENV=development                  # development | staging | production
APP__DEBUG=true
APP__LOG_LEVEL=info                   # debug | info | warning | error
APP__LOG_FILE=logs/archiva.log        # stdout | stderr | file path
APP__STORAGE_BACKEND=local            # local | r2
APP__LOCAL_STORAGE_PATH=storage       # path for local storage backend
APP__PROCESSING_CONCURRENCY=5         # files processed in parallel by the worker

# --- Backend ---
BACKEND__HOST=0.0.0.0
BACKEND__PORT=8000
BACKEND__CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend (read by Next.js, not by Pydantic) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase ---
SUPABASE__URL=https://your-project.supabase.co
SUPABASE__SECRET_KEY=sb_secret_...

# --- Database ---
DATABASE__URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE__POOL_MIN=2
DATABASE__POOL_MAX=10

# --- Cloudflare R2 ---
R2__ACCOUNT_ID=your-account-id
R2__ACCESS_KEY_ID=your-access-key
R2__SECRET_ACCESS_KEY=your-secret-key
R2__BUCKET_NAME=archiva-files
R2__ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# --- Groq (system default models) ---
# Powers the built-in locked default models seeded for every org.
GROQ__API_KEY=gsk_...
GROQ__BASE_URL=https://api.groq.com/openai/v1

# --- LLM ---
LLM__PROVIDER=ollama                  # ollama | vllm
LLM__OLLAMA_BASE_URL=http://localhost:11434
LLM__VLLM_BASE_URL=http://localhost:8001
LLM__MODEL=qwen2.5:14b
LLM__PROCESSING_MODEL=qwen2.5:7b

# --- PII service (read by the main backend) ---
# In docker-compose these are set on the backend service; for native runs:
PII__ENABLED=true
PII__URL=http://localhost:8500       # pii-service (host 8500 → container 8001)

# --- MLflow / MinIO (used by pii-service + docker-compose) ---
# pii-service is the only MLflow/MinIO client. Defaults match docker-compose.
MLFLOW__TRACKING_URI=http://localhost:5000
MLFLOW__S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
