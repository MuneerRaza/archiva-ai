# ===========================================
# Archiva.ai — Environment Variables
# Copy to .env and fill in your values
# ===========================================

# --- App ---
APP_ENV=development                  # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=debug                  # debug | info | warning | error

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Supabase ---
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Database (direct connection, not through Supabase API) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=archiva-files
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com

# --- LLM ---
LLM_PROVIDER=ollama                  # ollama | vllm
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8001
LLM_MODEL=qwen2.5:14b
PROCESSING_LLM_MODEL=qwen2.5:7b     # smaller model for summaries/extraction
