# pii-service — local (non-docker) run config. In docker-compose these come
# from the compose env block instead.

APP__LOG_LEVEL=info
APP__ENV=development

MLFLOW__TRACKING_URI=http://localhost:5000
MLFLOW__S3_ENDPOINT_URL=http://localhost:9000
MLFLOW__VISION_MODEL_NAME=pii-vision-yolo
MLFLOW__VISION_MODEL_STAGE=Production

# MLflow artifact access (MinIO) — also read directly by boto3/mlflow.
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio12345
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000

VISION__DEVICE=cpu
VISION__PRETRAINED_WEIGHTS=yolov8n.pt
